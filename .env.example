# Copy this file to `.env` and fill in your real keys.
# `.env` is git-ignored, so your keys stay out of version control.

# Required for the Gemini chatbot (Task 5) and compare_models (Task 4).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required for Task 1 (call_openai) and compare_models (Task 4).
OPENAI_API_KEY=

# Optional — only for Task 3 (call_anthropic).
ANTHROPIC_API_KEY=
